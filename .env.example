# Required: the bot token from the Discord Developer Portal
DISCORD_TOKEN=paste-your-bot-token
# Required: make up a long random password (16+ characters). The PC uploader uses the same one.
UPLOAD_SECRET=make-up-a-long-random-password
# Optional: the name the bot uses in its messages (also rename the app in the Developer Portal)
BOT_NAME=SYSTEM AI
# Recommended: your Discord server ID, so /posse shows up instantly
DISCORD_SERVER_ID=
# Recommended: time zone for /posse event dates
TIMEZONE=America/New_York
# Optional: a role that can use /posse officer (server admins always can)
OFFICER_ROLE_ID=
# Roles colored like the game. AUTO_ROLES=on creates Tank (blue shield), Healer (green cross) and DPS (red swords),
# CLASS_ROLES=on adds one role per class in its class color. Handed out after /posse iam <character>.
# The bot needs Manage Roles, and its own role must sit above these. Icons show on Boost level 2 servers.
AUTO_ROLES=on
CLASS_ROLES=on
# Or point at roles you already have:
ROLE_TANK_ID=
ROLE_HEALER_ID=
ROLE_DPS_ID=
# Greet new Discord members with random System AI lines (needs "Server Members Intent" ON in the
# Developer Portal > Bot). Channel: run /posse setwelcome there, or set WELCOME_CHANNEL_ID. off = no greetings.
WELCOME_NEW_MEMBERS=on
WELCOME_CHANNEL_ID=
# Monthly membership badges with pictures (1-11 months, then every year). Needs Server Members Intent.
TENURE_BADGES=on
# Optional: news channel ID (or just type /posse setfeed in the channel)
FEED_CHANNEL_ID=
# Where the bot keeps its state file (point a persistent volume here if your host has one)
DATA_DIR=/data
PORT=3000
